<?xml version="1.0" encoding="UTF-8"?>
<!--
  upstream-check.launchd.plist — 定期上游检查(可选,用户侧 opt-in)。
  LaunchAgent 每天 09:00 跑一次只读检查并写状态文件,供 motto 会话启动时读取
  (motto-maintenance skill §2)。只检查,不应用升级。

  安装(用户自己执行,勿自动):
    cp docs/maintenance/upstream-check.launchd.plist ~/Library/LaunchAgents/com.motto.upstream-check.plist
    launchctl load ~/Library/LaunchAgents/com.motto.upstream-check.plist
  卸载/回退:
    launchctl unload ~/Library/LaunchAgents/com.motto.upstream-check.plist && rm ...
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.motto.upstream-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/lesprivilege/Projects/Motto/scripts/upstream-check.sh</string>
    <string>--state</string>
    <string>/Users/lesprivilege/.pi/agent/maintenance/last-check.json</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/motto-upstream-check.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/motto-upstream-check.log</string>
</dict>
</plist>
